{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-lib",
    ":preserveSemverRanges",
    ":disableDependencyDashboard",
    "replacements:all"
  ],
  "labels": ["dependencies"],
  "automerge": true,
  "automergeType": "branch",
  "automergeSchedule": "after 10pm and before 5:00am",
  "packageRules": [
    {
      "matchPackagePatterns": [
        "dmn-js.*",
        "table-js"
      ],
      "groupName": "dmn-js dependencies",
      "groupSlug": "dmn-js"
    },
    {
      "matchPackagePatterns": [
        "form-js.*",
        "@bpmn-io/form-js.*"
      ],
      "groupName": "form-js dependencies",
      "groupSlug": "form-js"
    },
    {
      "matchPackagePatterns": [
        "eslint.*"
      ],
      "groupName": "eslint* dependencies",
      "groupSlug": "eslint"
    },
    {
      "matchPackagePatterns": [
        "karma.*",
        "puppeteer"
      ],
      "groupName": "karma* dependencies",
      "groupSlug": "karma"
    },
    {
      "matchPackagePatterns": [
        "webpack",
        ".*-loader"
      ],
      "groupName": "webpack* dependencies",
      "groupSlug": "webpack"
    },
    {
      "matchPackagePatterns": [
        "mocha",
        "chai",
        "sinon",
        "sinon-chai"
      ],
      "groupName": "test dependencies",
      "groupSlug": "test"
    },
    {
      "matchPackagePatterns": [
        "@rollup/.*",
        "rollup.*"
      ],
      "groupName": "rollup* dependencies",
      "groupSlug": "rollup"
    },
    {
      "description": "TODO(@barmac): remove once we are ready to adopt",
      "matchPackageNames": [
        "eslint"
      ],
      "allowedVersions": "<10.0.0"
    },
    {
      "description": "TODO(@barmac): remove once we are ready to adopt",
      "matchPackagePatterns": [
        "@babel/.*"
      ],
      "allowedVersions": "<8.0.0"
    },
    {
      "description": "TODO(@barmac): remove once we are ready to adopt",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.0.0"
    },
    {
      "description": "Own packages: update immediately, no release age",
      "matchSourceUrls": [
        "https://github.com/bpmn-io/*",
        "https://github.com/camunda/*"
      ],
      "minimumReleaseAge": "0 days",
      "schedule": "at any time"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "matchDepTypes": [
        "dependencies",
        "peerDependencies"
      ],
      "semanticCommitType": "deps"
    },
    {
      "matchCurrentVersion": "*",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "karma-chrome-launcher"
      ],
      "replacementName": "karma-chrome-launcher-2",
      "replacementVersion": "3.3.0"
    },
    {
      "matchCurrentVersion": "*",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "npm-run-all"
      ],
      "replacementName": "npm-run-all2",
      "replacementVersion": "9.0.2"
    },
    {
      "matchCurrentVersion": "*",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "cpx"
      ],
      "replacementName": "cpx2",
      "replacementVersion": "9.0.0"
    },
    {
      "description": "Never automerge majors (must stay last)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "minimumReleaseAge": "8 days",
  "github-actions": {
    "minimumReleaseAge": "8 days"
  },
  "semanticCommitType": "chore",
  "semanticCommitScope": null,
  "schedule": ["after 10pm and before 5:00am"],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
